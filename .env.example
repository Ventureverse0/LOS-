# =============================================================================
# STUDYOS / LEARNINGOS — LOCAL & CLOUD ENVIRONMENT CONFIGURATION (.env.example)
# Copy to `.env` when running locally, or run `npm run configure:local`.
# Secrets stay strictly on the local Express backend — never in browser code.
# =============================================================================

# Provider routing mode:
# auto | ollama | lmstudio | llamacpp | vllm | custom-openai | gemini | openai | groq | deepseek | anthropic | offline
LLM_PROVIDER_MODE="auto"

# Custom Local or OpenAI-Compatible Endpoint (LM Studio, llama.cpp, vLLM, LocalAI, LiteLLM, OpenRouter, etc.)
# Examples:
#   http://127.0.0.1:11434/v1   (Ollama)
#   http://127.0.0.1:1234/v1    (LM Studio)
#   http://127.0.0.1:8080/v1    (llama.cpp server)
#   http://127.0.0.1:8000/v1    (vLLM)
CUSTOM_LLM_BASE_URL=""
CUSTOM_LLM_MODEL=""
CUSTOM_LLM_API_KEY=""
CUSTOM_LLM_HEADERS_JSON=""

# Local Ollama / LM Studio convenience variables:
OLLAMA_BASE_URL=""
OLLAMA_MODEL="llama3.2"
LMSTUDIO_BASE_URL=""

# GEMINI_API_KEY: Primary cloud AI engine (@google/genai) + optional custom Gemini proxy URL.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
CUSTOM_GEMINI_BASE_URL=""

# Optional alternative cloud AI providers (auto-routed server-side):
OPENAI_API_KEY=""
GROQ_API_KEY=""
DEEPSEEK_API_KEY=""
ANTHROPIC_API_KEY=""

# Optional custom frontend-to-backend origin when running split local ports or Electron:
# Leave empty ("") when running unified `npm run dev` on http://localhost:3000.
VITE_API_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
